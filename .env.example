# Copy to .env for local runs (never commit .env). All values come from the environment.
META_MOCK=true
META_ACCESS_TOKEN=
GRAPH_API_VERSION=v26.0

MCP_AUTH_MODE=path_secret            # path_secret | bearer | both
MCP_PATH_SECRET=                     # >= 32 chars: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_KEYS=                        # LABEL:KEY,LABEL2:KEY2 (keys >= 32 chars) for bearer/both
CURSOR_SIGNING_KEY=                  # >= 32 chars, same generator
ALLOWED_HOSTS=localhost,127.0.0.1    # extra allowed Host values; Render's hostname is added automatically

META_MAX_CALLS_PER_HOUR=60
META_MAX_CALLS_PER_DAY=500
CLIENT_MAX_CALLS_PER_MINUTE=10

CACHE_TTL_ACTIVE=900
CACHE_TTL_HISTORICAL=21600
CACHE_TTL_ADVERTISER=86400
CACHE_MAX_ENTRIES=500
CACHE_MAX_BYTES=20000000

DEFAULT_LIMIT=10
MAX_LIMIT=50
MAX_PAGES_PER_CALL=1
MAX_SUMMARY_PAGES=2
AD_TEXT_MAX_CHARS=300
MAX_RESPONSE_CHARS=12000
LOG_LEVEL=INFO

# Optional extras (defaults shown)
# COLD_START_BUDGET_FACTOR=0.5   # budgets are scaled by this until the process has been up one window
# CACHE_STALE_MAX=86400          # how old cached data may be when served as a stale fallback
# USAGE_WARN_PCT=70
# USAGE_THROTTLE_PCT=85
# USAGE_STOP_PCT=95
# BREAKER_FAILURES=5
# BREAKER_COOLDOWN=60
# CLIENT_IP_HEADER=true-client-ip
